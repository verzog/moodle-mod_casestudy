{{!
    @template mod_casestudy/submission_confirmation

    Submission-confirmation dialog body shown before final submit.

    Example context (json):
    {
        "hasunanswered": false,
        "totalunanswered": 0
    }
}}

<div class="casestudy-submission-confirmation-content">
    <div class="mb-3">
        {{#str}} confirmclose, mod_casestudy {{/str}}
    </div>
    {{#hasunanswered}}
    <div class="alert alert-warning">
        {{#str}} submission_confirmation_unanswered, mod_casestudy, {{totalunanswered}} {{/str}}
    </div>
    {{/hasunanswered}}
</div>
