{{!
    @template mod_casestudy/grader_interface

    Grader interface for Case Study activity

    Context variables required for this template:
    * cmid - Course module ID

    Example context (json):
    {
        "cmid": 123
    }
}}

<div class="casestudy-grader-interface">
    <h3>{{#str}}graderinterface, mod_casestudy{{/str}}</h3>
    <div class="mb-3">
        <a href="submission.php?id={{cmid}}" class="btn btn-primary">
            {{#str}}viewsubmissions, mod_casestudy{{/str}}
        </a>
    </div>
</div>