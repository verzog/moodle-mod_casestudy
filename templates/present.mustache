{{!
    @template mod_casestudy/present

    Presenter view of a case study submission: answers only, for showing to a class.

    Context variables required for this template:
    * casestudyname - The activity name
    * student - The submitting student's full name
    * fields - Array of fields (name, value, description, type, issectionheading, hasvalue)

    Example context (json):
    {
        "casestudyname": "Melanoma case",
        "student": "Jane Doe",
        "fields": [
            {"name": "Presentation", "value": "", "description": "<p>Answer each item.</p>",
             "type": "sectionheading", "issectionheading": true, "hasvalue": true},
            {"name": "History", "value": "<p>55yo...</p>", "description": "",
             "type": "richtext", "issectionheading": false, "hasvalue": true}
        ]
    }
}}
<div class="casestudy-presenter">

    <div class="casestudy-presenter-header mb-4">
        <h2 class="mb-1">{{casestudyname}}</h2>
        <p class="lead text-muted mb-0">{{student}}</p>
    </div>

    {{#fields}}
        {{#issectionheading}}
        <h3 class="casestudy-presenter-section border-bottom pb-2 mt-5 mb-3">{{name}}</h3>
        {{#description}}
        <div class="casestudy-presenter-section-description text-muted mb-3">{{{description}}}</div>
        {{/description}}
        {{/issectionheading}}
        {{^issectionheading}}
        <div class="casestudy-presenter-field mb-4">
            <h4 class="casestudy-presenter-field-name h5 text-muted">{{name}}</h4>
            <div class="casestudy-presenter-field-value">{{{value}}}</div>
        </div>
        {{/issectionheading}}
    {{/fields}}

</div>
