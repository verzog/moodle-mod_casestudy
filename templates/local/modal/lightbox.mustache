{{!
    @template mod_casestudy/local/modal/lightbox

    Moodle modal template with one oaky button.

    The purpose of this template is to render an alert modal with an acceptance option.

    Example context (json):
    {
        "title": "Example cancel modal",
        "body": "Some example content for the body"
    }
}}

{{< core/modal }}
    {{$classes}}modal-lightbox modal-xl modal-dialog-centered{{/classes}}
    {{$headerclasses}}modal-lightbox{{/headerclasses}}
    {{$header}}<span id="{{uniqid}}-modal-title" data-region="title"></span>{{/header}}
    {{$footer}}{{/footer}}
{{/ core/modal }}
